.claude/.scratch/
.playwright-mcp/

# Oversized store-listing originals (~12.6 MB, none at a usable size). The
# upload-ready assets built from them ARE tracked — see store-assets/README.md.
store-assets/source/*.png
.playwright-output/

# Python bytecode from scripts/
__pycache__/
*.pyc

# Playwright
test-results/
playwright-report/
blob-report/
.playwright/
